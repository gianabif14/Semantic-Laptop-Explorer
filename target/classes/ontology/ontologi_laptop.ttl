@prefix : <http://example.org/laptop-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://example.org/laptop-ontology#> .

<http://example.org/laptop-ontology> rdf:type owl:Ontology ;
                                      rdfs:label "Ontologi Spesifikasi Laptop"@id .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/laptop-ontology#diproduksiOleh
:diproduksiOleh rdf:type owl:ObjectProperty ;
                owl:inverseOf :memproduksi ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :Laptop ;
                rdfs:range :Brand .


###  http://example.org/laptop-ontology#displayDari
:displayDari rdf:type owl:ObjectProperty ;
             owl:inverseOf :memilikiDisplay ;
             rdfs:domain :Display ;
             rdfs:range :Laptop .


###  http://example.org/laptop-ontology#gpuDari
:gpuDari rdf:type owl:ObjectProperty ;
         owl:inverseOf :memilikiGPU ;
         rdfs:domain :GraphicsCard ;
         rdfs:range :Laptop .


###  http://example.org/laptop-ontology#kompatibelDengan
:kompatibelDengan rdf:type owl:ObjectProperty ;
                  rdfs:domain :Laptop ;
                  rdfs:range :OperatingSystem .


###  http://example.org/laptop-ontology#memilikiDisplay
:memilikiDisplay rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Laptop ;
                 rdfs:range :Display .


###  http://example.org/laptop-ontology#memilikiGPU
:memilikiGPU rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Laptop ;
             rdfs:range :GraphicsCard .


###  http://example.org/laptop-ontology#memilikiOperatingSystem
:memilikiOperatingSystem rdf:type owl:ObjectProperty ;
                         owl:inverseOf :operatingSystemDari ;
                         rdf:type owl:FunctionalProperty ;
                         rdfs:domain :Laptop ;
                         rdfs:range :OperatingSystem .


###  http://example.org/laptop-ontology#memilikiPriceRange
:memilikiPriceRange rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Laptop ;
                    rdfs:range :PriceRange .


###  http://example.org/laptop-ontology#memilikiProcessor
:memilikiProcessor rdf:type owl:ObjectProperty ;
                   owl:inverseOf :processorDari ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain :Laptop ;
                   rdfs:range :Processor .


###  http://example.org/laptop-ontology#memilikiRAM
:memilikiRAM rdf:type owl:ObjectProperty ;
             owl:inverseOf :ramDari ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Laptop ;
             rdfs:range :RAM .


###  http://example.org/laptop-ontology#memilikiStorage
:memilikiStorage rdf:type owl:ObjectProperty ;
                 owl:inverseOf :storageDari ;
                 rdf:type owl:FunctionalProperty ;
                 rdfs:domain :Laptop ;
                 rdfs:range :Storage .


###  http://example.org/laptop-ontology#memproduksi
:memproduksi rdf:type owl:ObjectProperty ;
             rdfs:domain :Brand ;
             rdfs:range :Laptop .


###  http://example.org/laptop-ontology#operatingSystemDari
:operatingSystemDari rdf:type owl:ObjectProperty ;
                     rdfs:domain :OperatingSystem ;
                     rdfs:range :Laptop .


###  http://example.org/laptop-ontology#penerusDari
:penerusDari rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :Processor ;
             rdfs:range :Processor .


###  http://example.org/laptop-ontology#processorDari
:processorDari rdf:type owl:ObjectProperty ;
               rdfs:domain :Processor ;
               rdfs:range :Laptop .


###  http://example.org/laptop-ontology#ramDari
:ramDari rdf:type owl:ObjectProperty ;
         rdfs:domain :RAM ;
         rdfs:range :Laptop .


###  http://example.org/laptop-ontology#storageDari
:storageDari rdf:type owl:ObjectProperty ;
             rdfs:domain :Storage ;
             rdfs:range :Laptop .


