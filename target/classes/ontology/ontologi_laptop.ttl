#################################################################
#    Individuals
#################################################################

###  http://example.org/laptop-ontology#AppleM3Max
:AppleM3Max rdf:type owl:NamedIndividual ,
                     :M3 ;
            :jumlahCore 16 ;
            :jumlahThread 16 ;
            :namaProcessor "Apple M3 Max" ;
            :nodeProsesNm 3 .


###  http://example.org/laptop-ontology#AppleM3MaxGPU
:AppleM3MaxGPU rdf:type owl:NamedIndividual ,
                        :AppleIntegratedGraphics ;
               :adalahDedicated "false"^^xsd:boolean ;
               :namaGPU "Apple M3 Max GPU" .


###  http://example.org/laptop-ontology#AsusTUFGaming
:AsusTUFGaming rdf:type owl:NamedIndividual ,
                        :GamingLaptop ;
               :memilikiGPU :RTX5090 ;
