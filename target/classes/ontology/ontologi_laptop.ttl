#################################################################
#    SKEMA & DEFINISI SINONIM SEMANTIK (ONTOLOGI LAPTOP)
#    Mendukung Semantic Search berbasis sinonim bahasa Indonesia,
#    bahasa Inggris, akronim/singkatan, dan istilah populer.
#################################################################

skos:altLabel rdf:type owl:AnnotationProperty ;
    rdfs:label "label alternatif / sinonim"@id , "alternative label"@en .

skos:prefLabel rdf:type owl:AnnotationProperty ;
    rdfs:label "label utama"@id , "preferred label"@en .

:memilikiSinonim rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf skos:altLabel ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "memiliki sinonim"@id , "has synonym"@en .

:kataKunciPencarian rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf :memilikiSinonim ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "kata kunci pencarian"@id .

# --- Kelas Ekuivalen (OWL Equivalent Classes) ---
:Notebook rdf:type owl:Class ; owl:equivalentClass :Laptop ; rdfs:label "Notebook"@en .
:KomputerJinjing rdf:type owl:Class ; owl:equivalentClass :Laptop ; rdfs:label "Komputer Jinjing"@id .
:CPU rdf:type owl:Class ; owl:equivalentClass :Processor ; rdfs:label "CPU"@en .
:Prosesor rdf:type owl:Class ; owl:equivalentClass :Processor ; rdfs:label "Prosesor"@id .
:GPU rdf:type owl:Class ; owl:equivalentClass :GraphicsCard ; rdfs:label "GPU"@en .
:VGA rdf:type owl:Class ; owl:equivalentClass :GraphicsCard ; rdfs:label "VGA"@en .
:KartuGrafis rdf:type owl:Class ; owl:equivalentClass :GraphicsCard ; rdfs:label "Kartu Grafis"@id .
:MemoriUtama rdf:type owl:Class ; owl:equivalentClass :RAM ; rdfs:label "Memori Utama"@id .
:MediaPenyimpanan rdf:type owl:Class ; owl:equivalentClass :Storage ; rdfs:label "Media Penyimpanan"@id .
:Layar rdf:type owl:Class ; owl:equivalentClass :Display ; rdfs:label "Layar"@id .
:SistemOperasi rdf:type owl:Class ; owl:equivalentClass :OperatingSystem ; rdfs:label "Sistem Operasi"@id .
:Merek rdf:type owl:Class ; owl:equivalentClass :Brand ; rdfs:label "Merek"@id .
:RentangHarga rdf:type owl:Class ; owl:equivalentClass :PriceRange ; rdfs:label "Rentang Harga"@id .

# --- Sinonim pada Kelas Utama & Kategori Laptop ---
:Laptop :memilikiSinonim "laptop, notebook, komputer jinjing, komputer portabel, portable computer, perangkat komputasi" ;
    skos:altLabel "Notebook"@en , "Komputer Jinjing"@id .

:GamingLaptop :memilikiSinonim "laptop gaming, laptop game, laptop permainan, gaming notebook, esports, laptop gamer" ;
    skos:altLabel "Laptop Gaming"@id , "Laptop Permainan"@id , "Gaming Notebook"@en .

:BusinessLaptop :memilikiSinonim "laptop bisnis, laptop kerja, laptop kantor, laptop kantoran, office laptop, enterprise laptop, korporat, produktivitas, bisnis" ;
    skos:altLabel "Laptop Bisnis"@id , "Laptop Kantoran"@id , "Office Laptop"@en .

:Ultrabook :memilikiSinonim "ultrabook, laptop tipis, laptop ringan, thin and light, slim laptop, portable, mobilitas tinggi, compact laptop" ;
    skos:altLabel "Laptop Tipis & Ringan"@id , "Slim Notebook"@en .

:TwoInOneLaptop :memilikiSinonim "2-in-1, two in one, laptop lipat, convertible, hybrid laptop, laptop tablet, 360 derajat, x360, flip, layar sentuh, touchscreen" ;
    skos:altLabel "Laptop 2-in-1"@id , "Laptop Lipat Convertible"@id .

:WorkstationLaptop :memilikiSinonim "workstation, mobile workstation, laptop render, laptop editing, laptop kreator, content creator, arsitektur, 3d rendering, desain grafis, cad, studio, profesional" ;
    skos:altLabel "Laptop Workstation"@id , "Laptop Kreator & Render"@id .

:BudgetLaptop :memilikiSinonim "budget, laptop murah, terjangkau, ekonomis, entry level, entry-level, hemat, harga rendah" ;
    skos:altLabel "Laptop Ekonomis"@id , "Entry-Level Laptop"@en , "Laptop Pelajar"@id .

:MidRangeLaptop :memilikiSinonim "mid-range, midrange, menengah, kelas menengah, mainstream, standar, menengah ke atas" ;
    skos:altLabel "Laptop Kelas Menengah"@id , "Mainstream Laptop"@en .

:PremiumLaptop :memilikiSinonim "premium, kelas atas, flagship, mewah, eksekutif, profesional, kualitas tinggi" ;
    skos:altLabel "Laptop Premium"@id , "Flagship Laptop"@en .

:HighEndLaptop :memilikiSinonim "high-end, highend, tertinggi, sultan, monster, ekstrem, ultra high end, flagship tertinggi" ;
    skos:altLabel "Laptop High-End"@id , "Ultra High-End"@en .

